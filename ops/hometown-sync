#!/bin/sh
# Daily: log the restaurant visits recorded in Dinner Log and Where to Eat (Task 15). Installed under
# /etc/periodic/daily by setup-hometown.sh; runs as root and drops to the hometown user. Its settings (DATA_DIR and the
# two feeds' URLs and tokens) are in /etc/conf.d/hometown, which only root can read and cron doesn't load: they are
# exported here and reach manage.py through su's environment (su without -l keeps it), never on a command line. A
# failed run is also recorded in the database, which /healthz reports to the CT 210 health check. CONF and LOG may be
# overridden for a test run.
set -u
CONF=${CONF:-/etc/conf.d/hometown}
LOG=${LOG:-/var/log/ct210-ops.log}
log() { echo "$(date '+%F %T') hometown-sync: $*" >> "$LOG" 2>/dev/null || true; }

set -a
# shellcheck source=/dev/null
[ -f "$CONF" ] && . "$CONF"
set +a
DATA_DIR=${DATA_DIR:-/var/lib/hometown}
export DATA_DIR

if out=$(su -s /bin/sh hometown -c 'cd /opt/hometown && exec python3 manage.py sync-visits' 2>&1); then
  log "$out"
else
  log "FAILED: $out"
  exit 1
fi
