#!/bin/sh
# Daily: clear Google data cached for 30 days or more (Google's terms). Installed under /etc/periodic/daily by
# setup-hometown.sh; runs as root and drops to the hometown user. Its settings (DATA_DIR above all) are in
# /etc/conf.d/hometown, which only root can read and cron doesn't load: they are exported here and reach manage.py
# through su's environment (su without -l keeps it). CONF and LOG may be overridden for a test run.
set -u
CONF=${CONF:-/etc/conf.d/hometown}
LOG=${LOG:-/var/log/ct210-ops.log}
log() { echo "$(date '+%F %T') hometown-tidy: $*" >> "$LOG" 2>/dev/null || true; }

set -a
# shellcheck source=/dev/null
[ -f "$CONF" ] && . "$CONF"
set +a
DATA_DIR=${DATA_DIR:-/var/lib/hometown}
export DATA_DIR

if out=$(su -s /bin/sh hometown -c 'cd /opt/hometown && exec python3 manage.py tidy' 2>&1); then
  log "$out"
else
  log "FAILED: $out"
  exit 1
fi
