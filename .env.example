# Every setting, for development with `python3 app.py` (see the top of settings.py). Copy to .env and export it
# yourself (nothing loads this file); on the host the installer writes /etc/conf.d/hometown with the same keys.
# An empty value means the default. Never commit real values: .env is git-ignored.

# --- the app (settings.py) ---
# Where hometown.db lives. Empty: ./data next to app.py.
DATA_DIR=
# Port for `python3 app.py` and gunicorn (default 8782).
HOMETOWN_PORT=8782
# Address gunicorn binds on the host (read by the init script, not by settings.py; default 0.0.0.0 so the tunnel on another host can reach it).
HOMETOWN_BIND=0.0.0.0
# Page title and home-screen name. Keep it neutral: never a person's name.
APP_NAME=Hometown Table
# The towns: name|lat|lng or name|lat|lng|radius_km, separated by ";". Empty: the eight towns of spec section 4.
TOWNS=
# Each town's scan box is its centre plus and minus this many km each way (default 4).
TOWN_RADIUS_KM=4
# "Not lately" means nobody in the audience has been for more than this many days (default 45).
REST_DAYS=45
# Cloudflare Access team domain, e.g. example.cloudflareaccess.com. Empty: no Access sign-in works.
CF_TEAM_DOMAIN=
# The Access application's audience (AUD) tag.
CF_AUD=
# Comma-separated editor emails, e.g. alex@example.com,sam@example.com. Empty refuses everyone.
ADMIN_EMAILS=
# 1: requests from loopback and RFC 1918 addresses without Cloudflare headers are editor "lan". Development only.
LAN_EDIT=1
# Bearer key(s) for the MCP service on loopback, comma-separated for rotation: GET only. The installer generates it.
HOMETOWN_READ_KEY=
# Bearer key(s) for the MCP service on loopback: read and write. The installer generates it; never print it.
HOMETOWN_API_KEY=
# Google Places API (New) key. Empty: no scanning or list matching; everything else works.
GOOGLE_PLACES_KEY=
# Hard monthly cap on Place Details (Pro) calls, America/Los_Angeles months (default 3000; 5000 a month are free).
GOOGLE_MAX_PRO_PER_MONTH=3000
# 1: the accept form offers "Use this" for a live Google value OSM lacks; 0 hides it (default 1).
GOOGLE_PREFILL=1
# Scan tile size in km (default 1.5).
SCAN_TILE_KM=1.5
# Smallest tile a full tile is split down to, in km (default 0.25).
SCAN_MIN_TILE_KM=0.25
# Comma-separated Google place types the scan searches (default restaurant; cafe and bakery can be added).
SCAN_TYPES=restaurant
# Re-check a place's Google business status after this many days (default 28).
CLOSURE_CHECK_DAYS=28

# --- the MCP service (hometown-mcp, Task 13) ---
# Write level: none (default), log (log visits, star places) or all. At none the service refuses HOMETOWN_API_KEY.
HOMETOWN_MCP_WRITES=none
# Port the MCP service listens on (default 8783).
MCP_HTTP_PORT=8783
# Path the MCP is served at, behind its own Access application.
MCP_HTTP_PATH=/hometown/mcp
# Comma-separated public hostnames the MCP answers to.
MCP_PUBLIC_HOSTS=
# Cloudflare Access team domain for the MCP's Access application (managed OAuth).
CF_ACCESS_TEAM_DOMAIN=
# The MCP Access application's audience (AUD) tag.
CF_ACCESS_AUD=
# Comma-separated emails allowed to use the MCP (each also needs to be in ADMIN_EMAILS for "me" to work).
MCP_ALLOWED_EMAILS=
# Where the MCP service reaches the app.
HOMETOWN_URL=http://127.0.0.1:8782
