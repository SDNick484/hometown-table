# Household defaults baked into dist/setup-hometown.sh by installer/build.sh (Task 14).
# Copy to deploy/deploy.env (git-ignored) and fill in your own values.
# They only matter on a FIRST install; after that /etc/conf.d/hometown on the container is the source of truth.
# Values may not contain a double quote, backtick, dollar sign or backslash.

# Page title and home-screen name. Keep it neutral: never a person's name.
APP_NAME=Hometown Table

# Ports for the app and the MCP service. An existing install keeps the ports in its config.
# HOMETOWN_PORT=8782
# MCP_HTTP_PORT=8783

# Cloudflare Access for the app and for the MCP path, and the editors.
CF_TEAM_DOMAIN=
CF_AUD=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
ADMIN_EMAILS=
MCP_ALLOWED_EMAILS=
MCP_PUBLIC_HOSTS=

# Not here on purpose: HOMETOWN_READ_KEY and HOMETOWN_API_KEY (the installer generates them once and never prints
# them) and GOOGLE_PLACES_KEY (a secret: put it in /etc/conf.d/hometown with vim).
